    "/api/v1/reading-translations/{requestId}/cancel": {
      "parameters": [
        {
          "in": "path",
          "name": "requestId",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "post": {
        "operationId": "cancelReadingTranslation",
        "security": [
          {
            "basicAuth": []
          }
        ],
        "parameters": [

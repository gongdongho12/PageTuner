{
  "openapi": "3.0.3",
  "info": {
    "title": "PageTurner Reading Translation Previews",
    "version": "1.0.0",
    "description": "Authenticated, bounded page-range translation. See reading-translation-v1.md for hash, pacing, cancellation and TTL semantics."
  },
  "paths": {
    "/api/v1/reading-translations": {
      "post": {
        "operationId": "startReadingTranslation",
        "security": [
          {
            "basicAuth": []
          }
        ],
        "parameters": [
          {
            "in": "header",
            "name": "X-CSRF-TOKEN",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Fetch /api/v1/csrf and send its token with the same-session cookie."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReadingTranslationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Temporary reading state, never a full-chapter artifact.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadingTranslationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Authentication, source/range validation, request conflict or capacity error.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkflowProblem"
                }
              }
            }
          },
          "401": {
            "description": "Authentication, source/range validation, request conflict or capacity error.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkflowProblem"
                }
              }
            }
          },
          "403": {
            "description": "Authentication, source/range validation, request conflict or capacity error.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkflowProblem"
                }
              }
            }
          },
          "404": {
            "description": "Authentication, source/range validation, request conflict or capacity error.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkflowProblem"
                }
              }
            }
          },
          "409": {
            "description": "Authentication, source/range validation, request conflict or capacity error.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkflowProblem"
                }
              }
            }
          },
          "413": {
            "description": "Authentication, source/range validation, request conflict or capacity error.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkflowProblem"
                }
              }
            }
          },
          "429": {
            "description": "Authentication, source/range validation, request conflict or capacity error.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkflowProblem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/reading-translations/{requestId}": {
      "parameters": [
        {
          "in": "path",
          "name": "requestId",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "operationId": "getReadingTranslation",
        "security": [
          {
            "basicAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Temporary reading state, never a full-chapter artifact.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadingTranslationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Authentication, source/range validation, request conflict or capacity error.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkflowProblem"
                }
              }
            }
          },
          "401": {
            "description": "Authentication, source/range validation, request conflict or capacity error.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkflowProblem"
                }
              }
            }
          },
          "403": {
            "description": "Authentication, source/range validation, request conflict or capacity error.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkflowProblem"
                }
              }
            }
          },
          "404": {
            "description": "Authentication, source/range validation, request conflict or capacity error.",
            "content": {

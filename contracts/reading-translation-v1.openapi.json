            "in": "header",
            "name": "X-CSRF-TOKEN",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Fetch /api/v1/csrf and send its token with the same-session cookie."
          }
        ],
        "responses": {
          "200": {
            "description": "Temporary reading state, never a full-chapter artifact.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
